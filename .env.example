APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# cPanel SMTP: create a mailbox in cPanel > Email Accounts, then use
# mail.yourdomain.com (465 with smtps, or 587 with a null scheme).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME="no-reply@example.com"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15

# Transactional email notifications
EMAIL_ENABLED=true
EMAIL_ADMIN_ADDRESS="admin@example.com"

# Email theme (optional overrides)
MAIL_BRAND_NAME="${APP_NAME}"
MAIL_TAGLINE="Attendance & workforce management"
MAIL_SUPPORT_EMAIL=
# MAIL_FOOTER_NOTE=
# MAIL_THEME_INK="#200F35"
# MAIL_THEME_ACCENT="#10B981"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SONICPESA_API_KEY=
SONICPESA_API_SECRET=
SONICPESA_BASE_URL=https://api.sonicpesa.com
SONICPESA_WEBHOOK_SECRET=
SONICPESA_SANDBOX=true
SONICPESA_TIMEOUT=30

SMS_ENABLED=false
SMS_API_URL=https://portal.textify.africa/api/v1
SMS_API_KEY=
SMS_SENDER_NAME=BUSTISHA
SMS_SUPPORT_CONTACT=
SMS_ADMIN_PHONE=
SMS_TIMEOUT=15
